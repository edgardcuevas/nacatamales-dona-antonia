{
  "name": "nacatamales-dona-antonia-api",
  "version": "1.0.0",
  "description": "Secure REST API for Nacatamales de Dona Antonia",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "nodemon --env-file=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:db:status": "node --env-file=.env.test node_modules/knex/bin/cli.js --env test migrate:status",
    "test:db:latest": "node --env-file=.env.test node_modules/knex/bin/cli.js --env test migrate:latest",
    "test:db:rollback": "node --env-file=.env.test node_modules/knex/bin/cli.js --env test migrate:rollback",
    "test:db:list": "node --env-file=.env.test node_modules/knex/bin/cli.js --env test migrate:list",
    "videos:mark-remote-deleted": "node database/scripts/mark-videos-remote-deleted.js",
    "videos:mark-remote-deleted:test": "node database/scripts/mark-videos-remote-deleted.js --environment test",
    "test:integration:remote-deletion": "node --env-file=.env.test tests/integration/video-remote-deletion.integration.js"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.12.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "nodemon": "3.1.14"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
