NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3307
DB_NAME=nacatamales_dona_antonia
DB_USER=root
DB_PASSWORD=replace_with_your_database_password


JWT_ACCESS_TOKEN_SECRET=replace_with_secure_secret
JWT_ACCESS_TOKEN_TTL=15m

JWT_REFRESH_TOKEN_SECRET=replace_with_secure_secret
JWT_REFRESH_TOKEN_TTL=30d

IMAGEKIT_PUBLIC_KEY=replace_with_public_key
IMAGEKIT_PRIVATE_KEY=replace_with_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id
IMAGEKIT_FOLDER=nacatamales-dona-antonia

GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_or_base64_key
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# Number of trusted reverse proxies in front of the API. Set to 1 when
# a single proxy (nginx, Caddy, a cloud load balancer) forwards the
# requests, so rate limiting sees the real client IP instead of the
# proxy address shared by every visitor. Leave it empty when the server
# is exposed directly. Only integers >= 0 are accepted: "true" would
# let any client forge X-Forwarded-For and bypass the rate limiters.
TRUST_PROXY=

# The four variables below are read ONLY by the one-off scripts in
# database/scripts/ (create-initial-admin.js and
# reset-admin-password.js). The server does not need them to start, and
# env.js never reads them.
# INITIAL_ADMIN_EMAIL=replace_with_admin_email
# INITIAL_ADMIN_PASSWORD=replace_with_at_least_12_characters
# RESET_ADMIN_EMAIL=replace_with_admin_email
# RESET_ADMIN_PASSWORD=replace_with_at_least_12_characters
