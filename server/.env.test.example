# Plantilla del entorno de pruebas. Copiar a .env.test y ajustar.
#
# El entorno `test` de knexfile.js carga este archivo con
# `node --env-file=.env.test` de forma explicita. Las guardas del propio
# knexfile abortan el proceso si se intenta usar con otro proposito.

NODE_ENV=test

# Debe coincidir con el archivo realmente cargado. Si el proceso se
# lanza con .env en lugar de .env.test, la guarda TEST_ENV_SOURCE_ISOLATED
# aborta antes de cualquier conexion.
TEST_ENV_SOURCE=.env.test

# La guarda TEST_DATABASE_SUFFIX exige que el nombre termine en _test.
# La guarda TEST_DATABASE_DISTINCT_FROM_DEV exige que sea distinto del de
# development.
DB_HOST=replace_with_test_database_host
DB_PORT=3306
DB_NAME=replace_with_development_database_name_test
DB_USER=replace_with_test_database_user
DB_PASSWORD=replace_with_test_database_password

# Credenciales propias de pruebas. Nunca copies las de produccion.
JWT_ACCESS_TOKEN_SECRET=replace_with_test_access_secret_of_32_chars_min
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_SECRET=replace_with_test_refresh_secret_of_32_chars_min
JWT_REFRESH_TOKEN_TTL=30d

IMAGEKIT_PUBLIC_KEY=replace_with_public_key
IMAGEKIT_PRIVATE_KEY=replace_with_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id
IMAGEKIT_FOLDER=test-folder

GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_or_base64_key
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# Vacio cuando no hay proxy inverso delante de la API en pruebas.
TRUST_PROXY=