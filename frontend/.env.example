# Plantilla de variables del frontend. Copiar a .env.development o
# .env.production. Vite solo expone las variables que empiezan por VITE_ y las
# incrusta en el bundle durante el build: nunca pongas secretos aqui.

# Vacio a proposito: en produccion el sitio y la API comparten origen detras de
# Nginx y el cliente llama a /api de forma relativa. Un host cruzado necesita
# CORS, que este proyecto no tiene. Solo se rellena si la API vive en otro
# dominio (y entonces hay que resolver CORS en el proxy).
# VITE_API_BASE_URL=

# URL publica absoluta del sitio, con https y sin barra final. La usa el plugin
# de Vite para og:url, og:image, canonical, robots.txt y sitemap.xml. En
# despliegue, REQUIRE_SITE_URL=1 hace fallar el build si falta.
VITE_SITE_URL=
